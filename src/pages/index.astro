---
import SignalHero from '../components/SignalHero.astro';
import SignalCursor from '../components/SignalCursor.astro';
import '../styles/site.css';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="description" content="Canario Studios es un digital transformation studio nacido en El Salvador." />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='12' fill='%23f0bc15'/%3E%3C/svg%3E" />
    <title>Canario Studios</title>
    <script is:inline>
      // Hold the opening frame, inside the black stem, until the hero script paints it.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.dataset.intro = '';
    </script>
  </head>
  <body>
    <main><SignalHero /></main>
    <SignalCursor />
  </body>
</html>
