---
import wordmark from '../assets/canario-wordmark.svg?raw';

// A static surface is available before WebGL loads and when motion is reduced.
const dots = Array.from({ length: 40 * 32 }, (_, index) => {
  const column = Math.floor(index / 32);
  const row = index % 32;
  const depth = 320 + row * 150;
  const wave = Math.sin(column * 0.3) * 50 + Math.sin(row * 0.5) * 50;
  return {
    x: 720 + ((column - 19.5) * 150 * 435) / depth,
    y: 250 + ((355 - wave) * 435) / depth,
    radius: Math.max(0.5, (5.5 * 435) / depth),
    opacity: Math.max(0.08, 0.78 * (1 - depth / 8000)),
    signal: (index * 37) % 101 < 25,
  };
});
---

<section class="signal-hero" aria-labelledby="hero-title" data-signal-hero>
  <div class="hero-stage" data-hero-stage>
    <h1 id="hero-title" class="sr-only">Canario Studios</h1>
    <div class="signal-surface" data-signal-surface aria-hidden="true">
      <svg class="surface-poster" viewBox="0 0 1440 500" preserveAspectRatio="xMidYMid slice" focusable="false">
        {dots.map((dot) => (
          <circle cx={dot.x} cy={dot.y} r={dot.radius} opacity={dot.opacity} fill={dot.signal ? '#f0bc15' : '#000'} />
        ))}
      </svg>
    </div>
    <Fragment set:html={wordmark} />
    <a class="skip-hero" href="#signal">Saltar a la siguiente sección</a>
    <section id="signal" class="signal-intro" aria-labelledby="signal-intro-title" tabindex="-1" data-signal-intro>
    <div class="signal-intro__paper" aria-hidden="true"></div>
    <div class="signal-intro__backdrop" aria-hidden="true"></div>
    <p id="signal-intro-title" class="signal-intro__copy">
      <span class="signal-intro__line" data-intro-line="one">Siempre hay algo</span>
      <span class="signal-intro__line" data-intro-line="two"><span class="signal-intro__prefix">que podría </span><span class="signal-intro__accent">funcionar mejor</span>.</span>
    </p>
    <div class="signal-intro__examples" aria-label="Dónde puede haber una señal">
      <p data-signal-example>Un proceso.</p>
      <p data-signal-example>Una identidad.</p>
      <p data-signal-example>Una conexión.</p>
    </div>
    <div class="signal-intro__closing" data-signal-closing>
      <p>
        <span class="sr-only">Esa es la señal.</span>
        {/* Split per letter at build time, so the layout never shifts when JS runs. */}
        <span class="signal-closing__type" aria-hidden="true" data-closing-type>
          {['Esa', 'es', 'la'].map((word) => (
            <><span class="signal-closing__word">{[...word].map((char) => <span class="signal-closing__char" data-closing-char>{char}</span>)}</span>{' '}</>
          ))}
          <span class="signal-closing__word">
            {[...'señal'].map((char) => (
              <span class="signal-closing__char signal-closing__roll" data-closing-char>
                <span class="signal-closing__track" data-closing-track><span>{char}</span><span class="signal-closing__signal">{char}</span></span>
              </span>
            ))}<span class="signal-closing__char" data-closing-char>.</span>
          </span>
        </span>
      </p>
    </div>
    </section>
  </div>
</section>

<script>
  import { mountSignalHero } from '../scripts/signal-hero';

  const hero = document.querySelector<HTMLElement>('[data-signal-hero]');
  if (hero) mountSignalHero(hero);

</script>
