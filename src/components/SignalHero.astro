---
import wordmark from '../assets/canario-wordmark.svg?raw';
import '@fontsource-variable/geist-mono';
import { networkFrame, networkSize } from '../scripts/signal-network';

// A static surface is available before WebGL loads and when motion is reduced.
const dots = Array.from({ length: 40 * 32 }, (_, index) => {
  const column = Math.floor(index / 32);
  const row = index % 32;
  const depth = 320 + row * 150;
  const wave = Math.sin(column * 0.3) * 50 + Math.sin(row * 0.5) * 50;
  return {
    x: 720 + ((column - 19.5) * 150 * 435) / depth,
    y: 250 + ((355 - wave) * 435) / depth,
    radius: Math.max(0.5, (5.5 * 435) / depth),
    opacity: Math.max(0.08, 0.78 * (1 - depth / 8000)),
    signal: (index * 37) % 101 < 25,
  };
});

const words = (text: string) => text.split(' ');
// The heading is set in three lines: "siempre hay algo" / "que podría" / "funcionar mejor."
const breaks = ['algo', 'podría'];
const title = words('Siempre hay algo que podría funcionar mejor.').map((word, index) => ({ word, line: index < 3 ? 1 : index < 5 ? 2 : 3 }));
// The box's still frame: the node rests on a lattice point, with all twelve spokes.
const poster = networkFrame({ x: 5.5, y: 3.5 });
---

<section class="signal-hero" aria-labelledby="hero-title" data-signal-hero>
  <div class="hero-stage" data-hero-stage>
    <h1 id="hero-title" class="sr-only">Canario Studios</h1>
    <div class="signal-surface" data-signal-surface aria-hidden="true">
      <svg class="surface-poster" viewBox="0 0 1440 500" preserveAspectRatio="xMidYMid slice" focusable="false">
        {dots.map((dot) => (
          <circle cx={dot.x} cy={dot.y} r={dot.radius} opacity={dot.opacity} fill={dot.signal ? '#f0bc15' : '#000'} />
        ))}
      </svg>
    </div>
    <Fragment set:html={wordmark} />
    <a class="skip-hero" href="#signal">Saltar a la siguiente sección</a>
    <section id="signal" class="signal-intro" aria-labelledby="signal-intro-title" tabindex="-1" data-signal-intro>
    {/* Each word rises inside its own mask, so the heading can wrap on any screen. */}
    <div class="signal-statement" data-signal-statement>
      <h2 id="signal-intro-title" class="signal-statement__title">
        <span class="sr-only">Siempre hay algo que podría funcionar mejor.</span>
        {/* Split per letter at build time: the outer span follows the scroll, the inner one
            replays the loop, and the letters of "mejor" carry a yellow twin for the roll. */}
        <span aria-hidden="true">
          {title.map(({ word, line }) => (
            <><span class="signal-statement__mask" data-title-line={line}>{[...word].map((char) => (
              word === 'mejor.' && char !== '.' ? (
                <span class="signal-statement__char signal-statement__roll" data-title-char><span class="signal-statement__loop" data-title-loop><span class="signal-statement__track" data-title-track><span>{char}</span><span class="signal-statement__signal">{char}</span></span></span></span>
              ) : (
                <span class="signal-statement__char" data-title-char><span class="signal-statement__loop" data-title-loop>{char}</span></span>
              )
            ))}</span>{' '}{breaks.includes(word) && <br class="signal-statement__break" />}</>
          ))}
        </span>
      </h2>
      <ul class="signal-statement__list" aria-label="Dónde puede haber una señal">
        {['Un proceso.', 'Una identidad.', 'Una conexión.'].map((example) => (
          <li class="signal-statement__mask" data-signal-example><span class="signal-statement__word" data-statement-line>{example}</span></li>
        ))}
      </ul>
      <div class="signal-statement__box" aria-hidden="true" data-network-box>
        {['top', 'right', 'bottom', 'left'].map((edge) => <span class="signal-statement__edge" data-edge={edge}></span>)}
        {['column', 'row'].map((rule) => <span class="signal-statement__rule" data-rule={rule}></span>)}
        <p class="signal-statement__label" data-decode>Señal</p>
        <p class="signal-statement__note" data-decode>Todo negocio emite señales antes de pedir un cambio. Leerlas a tiempo es saber por dónde empezar.</p>
        <div class="signal-statement__network" data-network>
          <svg class="signal-statement__poster" viewBox={`0 0 ${networkSize.columns} ${networkSize.rows}`} focusable="false">
            {poster.spokes.map((spoke) => (
              <line x1={poster.node.x} y1={poster.node.y} x2={spoke.x} y2={spoke.y} stroke="#fff" stroke-opacity={0.72 * spoke.alpha} stroke-width="0.02" />
            ))}
            {poster.dots.map((dot) => <circle cx={dot.x} cy={dot.y} r={dot.r} fill="#fff" fill-opacity={dot.alpha} />)}
            <circle cx={poster.node.x} cy={poster.node.y} r={poster.node.r} fill="#fff" />
          </svg>
          <canvas class="signal-statement__canvas" data-network-canvas></canvas>
        </div>
      </div>
    </div>
    <div class="signal-intro__closing" data-signal-closing>
      <p>
        <span class="sr-only">Esa es la señal.</span>
        {/* Split per letter at build time, so the layout never shifts when JS runs. */}
        <span class="signal-closing__type" aria-hidden="true" data-closing-type>
          {['Esa', 'es', 'la'].map((word) => (
            <><span class="signal-closing__word">{[...word].map((char) => <span class="signal-closing__char" data-closing-char>{char}</span>)}</span>{' '}</>
          ))}
          <span class="signal-closing__word">
            {[...'señal'].map((char) => (
              <span class="signal-closing__char signal-closing__roll" data-closing-char>
                <span class="signal-closing__track" data-closing-track><span>{char}</span><span class="signal-closing__signal">{char}</span></span>
              </span>
            ))}<span class="signal-closing__char" data-closing-char>.</span>
          </span>
        </span>
      </p>
    </div>
    </section>
  </div>
</section>

<script>
  import { mountSignalHero } from '../scripts/signal-hero';

  const hero = document.querySelector<HTMLElement>('[data-signal-hero]');
  if (hero) mountSignalHero(hero);

</script>
