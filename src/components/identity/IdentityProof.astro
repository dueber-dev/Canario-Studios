---
import Arrow from '../Arrow.astro';
import Wordmark from './Wordmark.astro';
import { calibrations, calibrationCss, calibrationSpec, defaultCalibration } from './calibrations';
// En línea y no como import de estilos: así la ruta solo de desarrollo no deja CSS en dist.
import tokensCss from '../../styles/identity/tokens.css?raw';
import wordmarkCss from '../../styles/identity/wordmark.css?raw';
import proofCss from '../../styles/identity/proof.css?raw';

// Los mismos valores que src/styles/identity/tokens.css, para las fichas y el cálculo de contraste.
const color = {
  black: '#111210',
  canary: '#F3DF16',
  warm: '#F5F3EB',
  stoneDark: '#8E8C84',
  stoneLight: '#67655E',
  ruleDark: '#2E2F2B',
  ruleLight: '#D6D3C8',
};

const channel = (value: number) => {
  const c = value / 255;
  return c <= 0.04045 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4;
};
const luminance = (hex: string) => {
  const [r, g, b] = [1, 3, 5].map(i => channel(parseInt(hex.slice(i, i + 2), 16)));
  return 0.2126 * r + 0.7152 * g + 0.0722 * b;
};
const ratio = (a: string, b: string) => {
  const [hi, lo] = [luminance(a), luminance(b)].sort((x, y) => y - x);
  return (hi + 0.05) / (lo + 0.05);
};
const level = (value: number) => value >= 7 ? 'AAA' : value >= 4.5 ? 'AA' : value >= 3 ? 'AA grande · UI' : 'No apto';

const contrast = [
  { pair: 'Warm white / black', use: 'Texto principal en escenas black', fg: color.warm, bg: color.black },
  { pair: 'Black / warm white', use: 'Texto principal en escenas claras', fg: color.black, bg: color.warm },
  { pair: 'Canary / black', use: 'Signal Dot, foco, señal activa', fg: color.canary, bg: color.black },
  { pair: 'Black / canary', use: 'Texto sobre CTA amarillo', fg: color.black, bg: color.canary },
  { pair: 'Stone 400 / black', use: 'Texto secundario en black', fg: color.stoneDark, bg: color.black },
  { pair: 'Stone 600 / warm white', use: 'Texto secundario en warm white', fg: color.stoneLight, bg: color.warm },
  { pair: 'Canary / warm white', use: 'Nunca como texto, línea ni punto pequeño', fg: color.canary, bg: color.warm },
].map(item => ({ ...item, value: ratio(item.fg, item.bg) }));

const neutrals = [
  { name: 'Stone 400', hex: color.stoneDark, use: 'Texto secundario sobre black', kind: 'text', surface: 'surface-black' },
  { name: 'Stone 600', hex: color.stoneLight, use: 'Texto secundario sobre warm white', kind: 'text', surface: 'surface-warm' },
  { name: 'Rule dark', hex: color.ruleDark, use: 'Líneas y grid sobre black', kind: 'line', surface: 'surface-black' },
  { name: 'Rule light', hex: color.ruleLight, use: 'Líneas y grid sobre warm white', kind: 'line', surface: 'surface-warm' },
];

// Observación de ejemplo: posiciones en % de una jornada de 08:00 a 20:00.
const field = [
  { name: 'Presencia', ticks: [6, 15, 31, 47, 63, 79, 92] },
  { name: 'Atención', ticks: [3, 8, 12, 19, 24, 30, 35, 41, 46, 52, 57, 61, 66, 70, 74, 77, 80, 86, 88, 91, 94, 97], signal: 83.333 },
  { name: 'Ventas', ticks: [10, 26, 38, 55, 69, 85] },
  { name: 'Operación', ticks: [4, 17, 22, 36, 44, 59, 73, 81] },
  { name: 'Documentos', ticks: [9, 25, 49, 67] },
];

const typeRoles = [
  { role: 'Display 1', spec: 'Cabinet Grotesk 500 · 44–152 px · 0.94 · −0.045 em', cls: 't-d1', sample: 'Encuentra tu señal.' },
  { role: 'Display 2', spec: 'Cabinet Grotesk 500 · 36–88 px · 0.98 · −0.035 em', cls: 't-d2', sample: 'Diseño, automatización e integración.' },
  { role: 'Display 3', spec: 'Cabinet Grotesk 500 · 28–56 px · 1.04 · −0.028 em', cls: 't-d3', sample: 'Conectamos lo que tu negocio es con todo lo que puede ser.' },
  { role: 'Display 4', spec: 'Cabinet Grotesk 500 · 22–34 px · 1.12 · −0.018 em', cls: 't-d4', sample: 'Una presencia que abre puertas.' },
  { role: 'Lead', spec: 'Switzer 400 · 18–22 px · 1.45 · −0.012 em', cls: 't-lead', sample: 'Somos un estudio de transformación digital fundado en El Salvador. Combinamos diseño y desarrollo con automatización e inteligencia artificial.' },
  { role: 'Body', spec: 'Switzer 400 · 15–17 px · 1.6 · 62 caracteres máx.', cls: 't-body', sample: 'Diseñamos sitios web, conectamos agentes de IA con WhatsApp, chat y llamadas, e integramos tu CRM para dar continuidad a cada conversación. También convertimos documentos en datos con OCR y unimos lo físico con lo digital mediante tarjetas NFC. ¿Por dónde empezamos? Por entender cómo funciona tu negocio.' },
  { role: 'Label', spec: 'Switzer 500 · 11 px · +0.08 em · mayúsculas', cls: 't-label', sample: 'Transformación digital · Diseño · Automatización' },
  { role: 'Metadata', spec: 'Switzer 400 · 12 px · +0.01 em', cls: 't-meta', sample: 'Proyecto 01 — Presencia digital · El Salvador, 2026' },
];

const services = [
  { number: '01', label: 'Presencia digital', title: 'Una presencia que abre puertas.', description: 'Diseñamos sitios web y desarrollamos estrategias de marketing para que tu empresa se presente con claridad y llegue a las personas adecuadas.', tags: ['Diseño y desarrollo web', 'Marketing y presencia digital'] },
  { number: '02', label: 'Automatización e IA', title: 'Más atención. Menos tareas repetitivas.', description: 'Conectamos agentes de IA con tus canales de atención y tu CRM para responder consultas y dar continuidad a cada conversación.', tags: ['WhatsApp y chatbots', 'Agentes de voz', 'Integraciones con CRM'] },
  { number: '03', label: 'Digitalización e integración', title: 'Del mundo físico a tu sistema.', description: 'Convertimos documentos en datos utilizables con OCR y conectamos experiencias físicas con servicios digitales mediante tarjetas NFC.', tags: ['OCR y documentos', 'Tarjetas NFC', 'Integraciones a medida'] },
];

const spacing = [4, 8, 12, 16, 24, 32, 48, 64, 96, 128, 192];
const sizes = [14, 16, 20, 24, 32, 48];
const contact = 'mailto:german@dueber.dev?subject=Hablemos%20de%20mi%20proyecto%20%7C%20Canario%20Studios';
---
<!doctype html>
<html lang="es" data-cal={defaultCalibration} data-open="a" data-dot="ink">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="theme-color" content="#111210" />
    <link rel="icon" href="data:," />
    <link rel="preload" href="/fonts/cabinet-grotesk.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/switzer.woff2" as="font" type="font/woff2" crossorigin />
    <title>Canario Studios · Laboratorio de identidad 01</title>
    <style is:inline set:html={[tokensCss, wordmarkCss, calibrationCss(), proofCss].join('\n')}></style>
  </head>
  <body>
    <details class="lab-panel lab-ui surface-black" id="lab-panel">
      <summary class="lab-summary">
        <span class="t-label">Laboratorio 01</span>
        <span class="t-meta lab-state" data-lab-state>C{defaultCalibration} · Apertura A</span>
      </summary>
      <div class="lab-body">
        <fieldset class="lab-group">
          <legend class="t-label">Calibración del wordmark</legend>
          {calibrations.map(c => <label class="lab-option"><input type="radio" name="cal" value={c.id} checked={c.id === defaultCalibration} /><span>C{c.id}</span></label>)}
        </fieldset>
        <fieldset class="lab-group">
          <legend class="t-label">Apertura</legend>
          <label class="lab-option"><input type="radio" name="open" value="a" checked /><span>A · solo wordmark</span></label>
          <label class="lab-option"><input type="radio" name="open" value="b" /><span>B · con metadata</span></label>
        </fieldset>
        <fieldset class="lab-group">
          <legend class="t-label">Signal Dot sobre warm white</legend>
          <label class="lab-option"><input type="radio" name="dot" value="ink" checked /><span>Tinta</span></label>
          <label class="lab-option"><input type="radio" name="dot" value="canary" /><span>Canary</span></label>
        </fieldset>
        <fieldset class="lab-group">
          <legend class="t-label">Ayudas</legend>
          <label class="lab-option"><input type="checkbox" name="grid" /><span>Columnas</span></label>
        </fieldset>
        <p class="t-meta lab-keys">Teclado: <kbd>1</kbd> <kbd>2</kbd> <kbd>3</kbd> calibración · <kbd>A</kbd> <kbd>B</kbd> apertura · <kbd>G</kbd> columnas · <kbd>H</kbd> oculta la interfaz de revisión</p>
      </div>
    </details>
    <button type="button" class="lab-restore" data-lab-restore>Mostrar controles de revisión (H)</button>
    <p class="sr-only" role="status" aria-live="polite" data-lab-live></p>
    <div class="grid-overlay" aria-hidden="true">{Array.from({ length: 12 }, () => <span></span>)}</div>

    <main>
      <!-- 01 · Apertura -->
      <section class="opening surface-black" aria-label="Apertura">
        <div class="opening-lockup">
          <Wordmark as="h1" class="opening-wm" />
          <p class="opening-meta" lang="en">Digital transformation studio · El Salvador</p>
        </div>
      </section>

      <!-- 02 · Wordmark -->
      <section class="plate surface-black" id="wordmark" aria-labelledby="wordmark-title">
        <header class="plate-head cols">
          <p class="t-label head-index">02 — Wordmark</p>
          <h2 class="t-d4 head-title" id="wordmark-title">Una línea. Un punto que detecta.</h2>
          <p class="t-meta head-note">Cabinet Grotesk variable. El Signal Dot reemplaza el punto de la i de canario; la i de studios conserva el suyo. Calibraciones ópticas, todavía sin SVG definitivo.</p>
        </header>

        <div class="cal-list">
          {calibrations.map(c => (
            <div class="cal-row cols" data-cal={c.id}>
              <div class="cal-info">
                <button type="button" class="cal-pick" data-set-cal={c.id} aria-pressed={c.id === defaultCalibration ? 'true' : 'false'}>
                  <span class="cal-id">C{c.id}</span>
                  <span class="cal-name">{c.name}</span>
                </button>
                <p class="t-meta cal-intent">{c.intent}</p>
              </div>
              <div class="cal-mark"><Wordmark /></div>
              <dl class="cal-spec t-meta">
                {calibrationSpec(c).map(([term, value]) => <div><dt>{term}</dt><dd>{value}</dd></div>)}
              </dl>
            </div>
          ))}
        </div>

        <div class="crops cols">
          <div class="crops-intro">
            <p class="t-label">Signal Dot · detalle</p>
            <p class="t-meta muted">Contorno: punto original de Cabinet en el mismo peso. Líneas: base, altura x (0.485 em), altura del punto (0.670 em) y eje del asta.</p>
          </div>
          <div class="crop-set">
            {calibrations.map(c => (
              <figure class="crop" data-cal={c.id}>
                <div class="crop-frame" aria-hidden="true">
                  <span class="wm crop-wm"><span class="wm-canario">r<span class="wm-i">ı<span class="guide guide-base"></span><span class="guide guide-x"></span><span class="guide guide-cap"></span><span class="guide guide-axis"></span><span class="ghost"></span></span>o</span></span>
                </div>
                <figcaption class="t-meta"><span class="cal-id">C{c.id}</span> {c.name}</figcaption>
              </figure>
            ))}
          </div>
        </div>

        <div class="sizes">
          <p class="t-label sizes-title">Tamaños de uso · calibración activa</p>
          <div class="sizes-row surface-black">
            {sizes.map(size => <div class:list={['size-item', { 'size-large': size > 32 }]}><Wordmark style={`font-size:${size}px`} /><span class="t-meta muted">{size} px</span></div>)}
          </div>
          <div class="sizes-row surface-warm">
            {sizes.map(size => <div class:list={['size-item', { 'size-large': size > 32 }]}><Wordmark style={`font-size:${size}px`} /><span class="t-meta muted">{size} px</span></div>)}
          </div>
        </div>
      </section>

      <!-- 03 · Color -->
      <section class="plate surface-black color-plate" aria-labelledby="color-title">
        <header class="plate-head cols">
          <p class="t-label head-index">03 — Color</p>
          <h2 class="t-d4 head-title" id="color-title">El negro observa. El amarillo detecta. El blanco cálido aclara.</h2>
          <p class="t-meta head-note">Canary aparece solo donde algo está activo o detectado. Menos del 5 % de cualquier pantalla.</p>
        </header>
        <div class="color-split">
          <div class="color-field surface-black">
            <p class="t-label muted">Observation</p>
            <div>
              <p class="swatch-name">Black</p>
              <p class="swatch-hex">#111210</p>
              <p class="t-meta muted swatch-use">Apertura, observación, detección y cierre. Silencio para que la señal se vea.</p>
            </div>
          </div>
          <div class="color-field surface-warm">
            <p class="t-label muted">Clarity</p>
            <div>
              <p class="swatch-name">Warm white</p>
              <p class="swatch-hex">#F5F3EB</p>
              <p class="t-meta muted swatch-use">Lo que construimos: servicios, explicación y lectura larga.</p>
            </div>
            <div class="color-signal">
              <span class="signal-swatch" aria-hidden="true"></span>
              <p class="signal-label"><span class="t-label">Signal · detection · active</span><span class="signal-name">Canary <span class="signal-hex">#F3DF16</span></span></p>
            </div>
          </div>
        </div>

        <div class="color-detail cols">
          <div class="neutrals">
            <p class="t-label">Neutrales necesarios</p>
            <ul class="neutral-list">
              {neutrals.map(n => (
                <li class="neutral">
                  <span class:list={['neutral-sample', n.surface, `is-${n.kind}`]} style={`--sample:${n.hex}`} aria-hidden="true">{n.kind === 'text' ? 'Aa' : ''}</span>
                  <span class="neutral-name">{n.name}</span>
                  <span class="t-meta neutral-hex">{n.hex}</span>
                  <span class="t-meta muted neutral-use">{n.use}</span>
                </li>
              ))}
            </ul>
          </div>
          <table class="contrast">
            <caption class="t-label">Contraste · WCAG 2.2</caption>
            <thead class="t-meta muted"><tr><th scope="col">Par y uso</th><th scope="col">Ratio</th><th scope="col">Nivel</th></tr></thead>
            <tbody>
              {contrast.map(c => (
                <tr class:list={[{ 'is-fail': c.value < 3 }]}>
                  <th scope="row"><span class="pair-cell"><span class="chip" style={`color:${c.fg};background:${c.bg}`} aria-hidden="true">Aa</span><span class="pair">{c.pair}</span><span class="t-meta muted pair-use">{c.use}</span></span></th>
                  <td>{c.value.toFixed(2)}:1</td>
                  <td class="t-meta">{level(c.value)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <!-- 04 · Composición en black -->
      <section class="plate surface-black observe-plate" id="observar" aria-labelledby="observe-title">
        <header class="plate-head cols">
          <p class="t-label head-index">04 — Composición en black</p>
          <p class="t-meta head-note">Hipótesis de escena: SIGNAL / OBSERVE / DETECT. Composición estática, sin movimiento narrativo.</p>
        </header>
        <div class="observe cols">
          <p class="t-label muted observe-kicker">Observar</p>
          <h2 class="t-d2 observe-title" id="observe-title">Antes de construir, observamos.</h2>
          <p class="t-lead observe-copy">Entendemos cómo trabaja tu empresa: dónde se acumulan las consultas, qué tareas se repiten y qué información se pierde entre un sistema y otro.</p>
        </div>
        <figure class="field">
          <figcaption class="t-meta muted field-caption">Observación de ejemplo · una jornada, 08:00–20:00</figcaption>
          <div class="field-plot">
            {field.map(row => (
              <div class="field-row">
                <span class="t-meta field-name">{row.name}</span>
                <span class="field-line" aria-hidden="true">
                  {row.ticks.map(x => <i style={`--x:${x}%`}></i>)}
                  {row.signal && <b class="field-signal" style={`--x:${row.signal}%`}></b>}
                </span>
              </div>
            ))}
            <span class="field-mark" aria-hidden="true"></span>
            <div class="field-axis t-meta muted" aria-hidden="true"><span>08:00</span><span class="axis-mid">11:00</span><span>14:00</span><span class="axis-mid">17:00</span><span>20:00</span></div>
          </div>
          <p class="field-note"><span class="t-label">Señal detectada · 18:00</span><span class="t-body">Después del horario, las consultas por WhatsApp siguen llegando y nadie responde.</span></p>
        </figure>
      </section>

      <!-- 05 · Black → warm white -->
      <section class="seam" aria-labelledby="seam-title">
        <h2 class="sr-only" id="seam-title">Construir: transición de black a warm white</h2>
        <div class="seam-layer surface-black seam-top" aria-hidden="true"><span class="seam-word">construir</span></div>
        <div class="seam-layer surface-warm seam-bottom" aria-hidden="true"><span class="seam-word">construir</span></div>
        <p class="t-label seam-note seam-note-top">05 — Build · black</p>
        <p class="t-label seam-note seam-note-bottom">warm white · transición estática</p>
      </section>

      <!-- 06 · Tipografía -->
      <section class="plate surface-warm" aria-labelledby="type-title">
        <header class="plate-head cols">
          <p class="t-label head-index">06 — Tipografía</p>
          <h2 class="t-d4 head-title" id="type-title">Cabinet para la marca. Switzer para leer.</h2>
          <p class="t-meta head-note">Escala fluida entre 320 y 1440 px. Cabinet nunca por debajo de 22 px; Switzer para todo lo que se lee o se pulsa.</p>
        </header>
        <div class="type-list">
          {typeRoles.map(r => (
            <div class="type-row cols">
              <div class="type-meta"><p class="t-label">{r.role}</p><p class="t-meta muted">{r.spec}</p></div>
              <div class="type-sample"><p class={r.cls}>{r.sample}</p></div>
            </div>
          ))}
          <div class="type-row cols">
            <div class="type-meta"><p class="t-label">Diacríticos</p><p class="t-meta muted">Cabinet / Switzer</p></div>
            <div class="type-sample glyphs">
              <p class="glyphs-display">á é í ó ú ü ñ Á É Í Ó Ú Ü Ñ ¿? ¡! « » — ·</p>
              <p class="glyphs-text">á é í ó ú ü ñ Á É Í Ó Ú Ü Ñ ¿? ¡! « » — · Diseño, automatización, información, años, pingüino.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- 07 · Líneas y grid -->
      <section class="plate surface-warm lines-plate" aria-labelledby="grid-title">
        <header class="plate-head cols">
          <p class="t-label head-index">07 — Líneas y grid</p>
          <h2 class="t-d4 head-title" id="grid-title">Estructura que se nota solo cuando ayuda a leer.</h2>
          <p class="t-meta head-note">Pulsa G para superponer las columnas en toda la hoja.</p>
        </header>

        <div class="grid-demo">
          <div class="grid-live" aria-hidden="true">{Array.from({ length: 12 }, (_, i) => <span><i>{String(i + 1).padStart(2, '0')}</i></span>)}</div>
          <p class="t-meta grid-live-label"><span class="bp bp-mobile">Activo: móvil</span><span class="bp bp-tablet">Activo: tableta</span><span class="bp bp-desktop">Activo: escritorio</span></p>
        </div>
        <table class="bp-table t-meta">
          <caption class="sr-only">Grid por anchura</caption>
          <thead class="muted"><tr><th scope="col">Anchura</th><th scope="col">Columnas</th><th scope="col">Margen</th><th scope="col">Medianil</th></tr></thead>
          <tbody>
            <tr><th scope="row">Móvil · &lt; 640</th><td>4</td><td>20–32 px</td><td>16 px</td></tr>
            <tr><th scope="row">Tableta · 640–1023</th><td>8</td><td>32–51 px</td><td>20 px</td></tr>
            <tr><th scope="row">Escritorio · ≥ 1024</th><td>12</td><td>51–80 px</td><td>24 px</td></tr>
          </tbody>
        </table>

        <div class="lines cols">
          <div class="line-spec"><span class="ln ln-rule" aria-hidden="true"></span><p class="t-label">Regla</p><p class="t-meta muted">1 px, color de línea. Separa secciones y filas.</p></div>
          <div class="line-spec"><span class="ln ln-ink" aria-hidden="true"></span><p class="t-label">Regla de énfasis</p><p class="t-meta muted">1 px en tinta. Una por vista como máximo.</p></div>
          <div class="line-spec"><span class="ln ln-index" aria-hidden="true"><i></i><b>01</b></span><p class="t-label">Índice</p><p class="t-meta muted">24 px de línea y número. Ordena, no decora.</p></div>
          <div class="line-spec"><span class="ln ln-measure" aria-hidden="true"><b>96</b></span><p class="t-label">Medida</p><p class="t-meta muted">Terminales de 7 px. Solo en material técnico.</p></div>
        </div>

        <div class="space cols">
          <p class="t-label space-title">Espacio · base 8</p>
          <ul class="space-list">
            {spacing.map(value => <li style={`--v:${value}px`}><span class="t-meta">{value}</span><i aria-hidden="true"></i></li>)}
          </ul>
        </div>
      </section>

      <!-- 08 · Composición en warm white -->
      <section class="plate surface-warm build-plate" aria-labelledby="build-title">
        <header class="plate-head cols">
          <p class="t-label head-index">08 — Composición en warm white</p>
          <p class="t-meta head-note">Hipótesis de escena: WHAT WE BUILD.</p>
        </header>
        <div class="build-intro cols">
          <p class="t-label muted build-kicker">Qué construimos</p>
          <h2 class="t-d2 build-title" id="build-title">Lo que construimos contigo.</h2>
        </div>
        <ol class="build-list">
          {services.map(s => (
            <li class="build-item cols">
              <span class="build-num" aria-hidden="true">{s.number}</span>
              <div class="build-head"><p class="t-label muted">{s.label}</p><h3 class="t-d4">{s.title}</h3></div>
              <p class="t-body build-copy">{s.description}</p>
              <p class="t-meta muted build-tags">{s.tags.join(' · ')}</p>
            </li>
          ))}
        </ol>
        <div class="build-actions">
          <a class="cta cta-primary" href={contact}><span class="cta-dot" aria-hidden="true"></span>Hablemos de tu proyecto<Arrow /></a>
          <a class="cta cta-link" href="#observar">Cómo empezamos<Arrow /></a>
        </div>
      </section>

      <!-- 09 · CTA -->
      <section class="cta-plate" aria-labelledby="cta-title">
        <div class="cta-half surface-warm">
          <header class="cta-head">
            <h2 class="t-label" id="cta-title">09 — CTA</h2>
            <p class="t-meta muted">Sobre warm white: bloque negro que lleva la señal.</p>
          </header>
          <div class="cta-demo">
